use @piton/belay
use @piton/config
use @piton/packaging

from @piton/belay import ClaudeCodeAdapter

export piton-config Project:
    root: ./spec
    entry: ./spec/project.pi

    plugins:
        - {Belay}

    packages:
        - {Emul}

    dependencies:
        - https://github.com/piton-lang/crux.git

belay-config Belay:
    codeRoot: .

    adapters:
        - {ClaudeCodeAdapter}

// The Emul specification is a package. spec/Package.pi explains it.
piton-package Emul:
    name: emul
    root: ./spec
