// A recipe card: a gradient "photo", meta chips, ingredients and numbered steps.

component Table:
    display: flex
    justifyContent: center
    padding: 48px 40px
    backgroundColor: #f5efe6
    color: #2b2118

component Card:
    display: flex
    flexDirection: column
    width: 100%
    overflow: hidden
    backgroundColor: #fffdf9
    borderRadius: 24px
    boxShadow: 0 2px 4px rgba(64, 40, 16, 0.06), 0 20px 48px rgba(64, 40, 16, 0.12)

component Photo:
    position: relative
    height: 260px
    overflow: hidden
    backgroundImage: radial-gradient(circle at 70% 40%, #fde68a, #f59e0b 35%, #b45309 75%, #78350f)

// An emoji scattered across the "photo".
component Food:
    attribute size: big | small = small
    position: absolute
    fontFamily: "Noto Color Emoji"
    fontSize: 44px
    lineHeight: 1

    when size == big:
        fontSize: 132px

component Ribbon:
    position: absolute
    left: 32px
    bottom: 28px
    padding: 7px 14px
    borderRadius: 999px
    backgroundColor: rgba(255, 253, 249, 0.92)
    fontSize: 12px
    fontWeight: 700
    letterSpacing: 1.2px
    textTransform: uppercase
    color: #9a3412

component Content:
    display: flex
    flexDirection: column
    gap: 28px
    padding: 36px 40px 40px

component Intro:
    display: flex
    flexDirection: column
    gap: 10px

component Title:
    htmlTag: h1
    fontFamily: Fraunces
    fontSize: 40px
    fontWeight: 600
    lineHeight: 1.1
    letterSpacing: -0.8px
    color: #2b2118

component Lede:
    fontSize: 16px
    lineHeight: 1.6
    color: #6b5b4b

component Chips:
    display: flex
    gap: 10px

component Chip:
    attribute tone: plain | good = plain
    display: flex
    alignItems: center
    gap: 8px
    padding: 8px 14px
    borderRadius: 999px
    backgroundColor: #f5efe6
    fontSize: 14px
    fontWeight: 500
    color: #4a3b2c

    when tone == good:
        backgroundColor: #e7f5e9
        color: #166534

component Icon:
    fontFamily: "Noto Color Emoji"
    fontSize: 15px

component Columns:
    display: grid
    gridTemplateColumns: 260px 1fr
    gap: 40px
    paddingTop: 28px
    borderTop: 1px solid #efe6d8

component Column:
    display: flex
    flexDirection: column
    gap: 16px

component Heading:
    htmlTag: h2
    fontFamily: Fraunces
    fontSize: 22px
    fontWeight: 600
    color: #2b2118

component Ingredients:
    display: flex
    flexDirection: column

component Ingredient:
    display: flex
    justifyContent: space-between
    gap: 12px
    padding: 10px 0
    borderBottom: 1px dashed #e6dccd
    fontSize: 15px
    color: #2b2118

component Amount:
    fontWeight: 700
    fontSize: 15px
    color: #b45309

component Steps:
    display: flex
    flexDirection: column
    gap: 18px

component Step:
    display: flex
    gap: 16px
    alignItems: flex-start

component Number:
    display: flex
    alignItems: center
    justifyContent: center
    flexShrink: 0
    width: 32px
    height: 32px
    borderRadius: 999px
    backgroundColor: #b45309
    color: #fffdf9
    fontSize: 14px
    fontWeight: 700

component StepText:
    paddingTop: 5px
    fontSize: 15px
    lineHeight: 1.6
    color: #4a3b2c

component Pos1:
    position: absolute
    top: 40px
    left: 420px

component Pos2:
    position: absolute
    top: 30px
    left: 120px
    rotate: -18deg

component Pos3:
    position: absolute
    top: 150px
    left: 640px
    rotate: 14deg

component Pos4:
    position: absolute
    top: 170px
    left: 250px
    rotate: 8deg

component Pos5:
    position: absolute
    top: 24px
    left: 650px
    rotate: -10deg

export composition Recipe {
    Table {
        Card {
            Photo {
                Pos1 {
                    Food { size: big, "🍝" }
                }
                Pos2 {
                    Food { "🍋" }
                }
                Pos3 {
                    Food { "🌿" }
                }
                Pos4 {
                    Food { "🧄" }
                }
                Pos5 {
                    Food { "🍅" }
                }
                Ribbon { "Weeknight favourite" }
            }
            Content {
                Intro {
                    Title { "Lemon & Basil Spaghetti" }
                    Lede {
                        "Bright, glossy and ready in under half an hour. The pasta water turns lemon, butter and parmesan into a silky sauce without any cream."
                    }
                }
                Chips {
                    Chip {
                        Icon { "⏳" }
                        "25 min"
                    }
                    Chip {
                        Icon { "🥣" }
                        "Serves 4"
                    }
                    Chip {
                        tone: good
                        Icon { "🌱" }
                        "Vegetarian"
                    }
                    Chip {
                        tone: good
                        Icon { "👌" }
                        "Easy"
                    }
                }
                Columns {
                    Column {
                        Heading { "Ingredients" }
                        Ingredients {
                            Ingredient {
                                "Spaghetti"
                                Amount { "400 g" }
                            }
                            Ingredient {
                                "Unsalted butter"
                                Amount { "60 g" }
                            }
                            Ingredient {
                                "Lemons, zest & juice"
                                Amount { "2" }
                            }
                            Ingredient {
                                "Garlic cloves"
                                Amount { "3" }
                            }
                            Ingredient {
                                "Parmesan, grated"
                                Amount { "80 g" }
                            }
                            Ingredient {
                                "Fresh basil"
                                Amount { "1 bunch" }
                            }
                        }
                    }
                    Column {
                        Heading { "Method" }
                        Steps {
                            Step {
                                Number { "1" }
                                StepText {
                                    "Cook the spaghetti in well-salted water until just al dente. Keep a mug of the cooking water."
                                }
                            }
                            Step {
                                Number { "2" }
                                StepText {
                                    "Melt the butter over low heat and soften the sliced garlic for two minutes, without colouring it."
                                }
                            }
                            Step {
                                Number { "3" }
                                StepText {
                                    "Add the lemon zest and juice, the drained pasta and a splash of pasta water. Toss until glossy."
                                }
                            }
                            Step {
                                Number { "4" }
                                StepText {
                                    "Off the heat, fold in the parmesan and torn basil. Season with black pepper and serve at once."
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
