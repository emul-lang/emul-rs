                        Stats {
                            Stat { "💬 1" }
                        }
                        Faces {
                            Small { tint: teal, "JK" }
                        }
                    }
                }
                Task {
                    Tags {
                        Tag { priority: medium, "Medium" }
                        Label { "Research" }
                    }
                    TaskTitle {
                        "Interview five users who abandoned at shipping"
                    }
                    Meta {
                        Stats {
                            Stat { "💬 7" }
                            Stat { "📎 1" }
                        }
                        Faces {
                            Small { tint: violet, "AM" }
                            Small { tint: amber, "LP" }
                        }
                    }
                }
                AddCard { "+  Add a card" }
            }
            Column {
                ColumnHead {
                    Dot { stage: doing }
                    ColumnName { "In progress" }
                    Count { "2" }
                }
                Task {
                    Tags {
                        Tag { priority: high, "High" }
                        Label { "Frontend" }
                    }
                    TaskTitle {
                        "One-page checkout with inline address validation"
                    }
                    Progress {
                        Fill { amount: most }
                    }
                    Meta {
                        Stats {
                            Stat { "✅ 8/10" }
                            Stat { "💬 12" }
                        }
                        Faces {
                            Small { tint: violet, "AM" }
                            Small { tint: teal, "JK" }
                        }
                    }
                }
                Task {
                    Tags {
                        Tag { priority: medium, "Medium" }
                        Label { "Design" }
                    }
                    TaskTitle { "Order summary drawer for small screens" }
                    Progress {
                        Fill { amount: quarter }
                    }
                    Meta {
                        Stats {
                            Stat { "✅ 1/4" }
                            Stat { "💬 3" }
                        }
                        Faces {
                            Small { tint: amber, "LP" }
                        }
                    }
                }
            }
            Column {
                ColumnHead {
                    Dot { stage: review }
                    ColumnName { "In review" }
                    Count { "2" }
                }
                Task {
                    Tags {
                        Tag { priority: medium, "Medium" }
                        Label { "Backend" }
                    }
                    TaskTitle { "Cache shipping quotes for 10 minutes" }
                    TaskNote {
                        "PR #482 is open. Load test shows p95 down from 840 ms to 120 ms."
                    }
                    Meta {
                        Stats {
                            Stat { "💬 5" }
                        }
                        Faces {
                            Small { tint: teal, "JK" }
                        }
                    }
                }
                Task {
                    Tags {
                        Tag { priority: low, "Low" }
                        Label { "QA" }
                    }
                    TaskTitle { "Regression pass on saved cards" }
                    Progress {
                        Fill { amount: half }
                    }
                    Meta {
                        Stats {
                            Stat { "✅ 6/12" }
                        }
                        Faces {
                            Small { tint: rose, "SR" }
                        }
                    }
                }
            }
            Column {
                ColumnHead {
                    Dot { stage: done }
                    ColumnName { "Done" }
                    Count { "2" }
                }
                Task {
                    Tags {
                        Tag { priority: high, "High" }
                        Label { "Security" }
                    }
                    TaskTitle { "3-D Secure 2 challenge flow" }
                    Progress {
                        Fill { amount: full }
                    }
                    Meta {
                        Stats {
                            Stat { "✅ 9/9" }
