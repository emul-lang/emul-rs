                    }
                    TaskTitle { "Track coupon field focus and errors" }
                    Progress {
                        Fill { amount: full }
                    }
                    Meta {
                        Stats {
                            Stat { "✅ 3/3" }
                        }
                        Faces {
                            Small { tint: amber, "LP" }
