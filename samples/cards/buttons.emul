export component DefaultButton:
    htmlTag: button
    display: flex
    alignItems: center
    borderRadius: 4px
    backgroundColor: #e4e4e7

export component MyButton extends DefaultButton:
    padding: 8px 12px
    color: #dc2626
    fontWeight: 600

export component SecondaryButton extends MyButton:
    backgroundColor: #ffffff
    border: 1px solid #dc2626
