from ../lib import
    Banner
    Body
    Card
    Copy
    Grid
    Hero
    MyButton
    Page
    SecondaryButton
    Strong
    Title

// Layout pieces
component MyLayout:
    display: flex
    flexDirection: row
    gap: 16px
    padding: 64px

export composition MyComposition {
    MyLayout {
        SecondaryButton { "Click Me" }
        MyButton { "Click Me Again", title: The second button }
    }
}

export composition Cards {
    Page {
        Banner { "Designs that render everywhere" }
        Grid {
            Card {
                Hero { src: ./images/hero.png, alt: "Hero, image" }
                Body {
                    Title { "First card" }
                    Copy {
                        "Some text that wraps across a few lines, with an "
                        Strong { "inline bit" }
                        " in the middle of it."
                    }
                }
            }
            Card {
                Body {
                    Title { "Second" }
                    Copy { "Short." }
                }
            }
            Card {
                Body {
                    Title { "Third card" }
                    Copy {
                        "More text here to fill the card out a little bit more than the others."
                    }
                }
            }
        }
    }
}
