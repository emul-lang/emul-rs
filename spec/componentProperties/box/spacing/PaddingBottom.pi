export anchor PaddingBottom:
    description:
        Sets the space between the component's content and its bottom border.

    identifier: paddingBottom

    cssProperty:
        Corresponds to the CSS `padding-bottom` property.

    values:
        - `<length>`
        - `<percentage>`

    initial: 0

    appliesTo: All components.

    example:
        ```emul
        \\\
        component Example:
            paddingBottom: 16px
        \\\
        ```
