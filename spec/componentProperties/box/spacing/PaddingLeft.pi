export anchor PaddingLeft:
    description:
        Sets the space between the component's content and its left border.

    identifier: paddingLeft

    cssProperty:
        Corresponds to the CSS `padding-left` property.

    values:
        - `<length>`
        - `<percentage>`

    initial: 0

    appliesTo: All components.

    example:
        ```emul
        \\\
        component Example:
            paddingLeft: 12px
        \\\
        ```
